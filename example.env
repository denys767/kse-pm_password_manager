# Copy to .env and fill in real values. .env is gitignored and auto-loaded by
# spring-dotenv (pom.xml) on `mvn spring-boot:run` — no manual `export` needed.

# Defaults already match `docker compose up -d` (Postgres :5432, Keycloak :8081, realm kse-pm).
DB_URL=jdbc:postgresql://localhost:5432/pm
DB_USER=pm
DB_PASSWORD=pm
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/kse-pm

# Google Cloud Console -> APIs & Services -> Credentials -> the OAuth 2.0 Client ID
# matching keycloak/realm-export.json's Google identity provider (clientId is
# already in the file; this is only its secret). `docker compose up -d` reads
# this file automatically and substitutes it into the imported realm's
# ${GOOGLE_CLIENT_SECRET} placeholder. Without it, "Sign in with Google" fails
# late with a generic Keycloak "Invalid username or password" error page,
# because the token exchange with Google is rejected (invalid_client).
GOOGLE_CLIENT_SECRET=

# Read-only Google Workspace Directory API. Every credential mode needs the
# service account's OAuth Client ID authorized for domain-wide delegation in the
# Workspace Admin Console with the three admin.directory.*.readonly scopes.
#
# Pick ONE credential source. It must be able to renew itself forever:
#
#   A. Workload identity federation (recommended off GCP, keyless) — the app
#      authenticates to this stack's own Keycloak as a confidential client
#      (client_credentials: a machine grant, no human, no reauth policy) and
#      exchanges that token at Google STS for a caller identity that signs the
#      delegation assertion. No downloaded key, so it works even when
#      Workspace admins won't authorize one. Set:
#         WORKSPACE_FEDERATION_TOKEN_URL=https://auth.pm.example.com/realms/kse-pm/protocol/openid-connect/token
#         WORKSPACE_FEDERATION_CLIENT_ID=kse-pm-federation
#         WORKSPACE_FEDERATION_CLIENT_SECRET=...
#         WORKSPACE_FEDERATION_AUDIENCE=//iam.googleapis.com/projects/<n>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
#      See docs/DEPLOYMENT.md for the one-time `gcloud iam workload-identity-pools`
#      setup and the matching Keycloak confidential client.
#
#   B. Attached service account (GCE/GKE only) — leave federation and the key
#      path empty; ADC resolves through the metadata server and the app
#      impersonates GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL via IAM Credentials
#      signJwt. The attached identity needs roles/iam.serviceAccountTokenCreator
#      on it.
#
#   C. Service-account key (last resort; needs a downloaded private key most
#      Workspace admins will not authorize) — the key signs the delegation
#      assertion locally. Mount it read-only and point this at it:
#         GOOGLE_WORKSPACE_CREDENTIALS_PATH=/run/secrets/workspace-sa.json
#
# `gcloud auth application-default login` is a *developer-only* fallback: that
# is a user credential, and Google's reauth policy expires it within hours
# ("invalid_grant / invalid_rapt"), taking directory suggestions, group sync and
# new shares down with it. The application logs a warning at startup and on the
# Admin tab when it detects one.
WORKSPACE_FEDERATION_TOKEN_URL=
WORKSPACE_FEDERATION_CLIENT_ID=
WORKSPACE_FEDERATION_CLIENT_SECRET=
WORKSPACE_FEDERATION_AUDIENCE=
GOOGLE_WORKSPACE_CREDENTIALS_PATH=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
GOOGLE_WORKSPACE_DOMAIN=kse.org.ua

# Shared secret Keycloak sends with audit events posted to /api/audit/keycloak-events.
KEYCLOAK_EVENTS_SECRET=
