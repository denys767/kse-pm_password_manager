{
  "realm": "kse-pm",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular vault user" },
      { "name": "admin", "description": "Application administrator" },
      { "name": "security", "description": "Security officer with audit access" }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "kse-pm-web",
      "name": "KSE Password Manager Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kse-pm-admin",
      "name": "KSE Password Manager Admin API (read-only)",
      "description": "Service account used only to suggest Keycloak group members for Collections.",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "secret": "REPLACE_WITH_KEYCLOAK_ADMIN_CLIENT_SECRET",
      "serviceAccountClientRoles": {
        "realm-management": ["view-users"]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google Workspace",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
        "clientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
        "hostedDomain": "kse.org.ua",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "groups": [
    { "name": "dev-team" },
    { "name": "finance" }
  ]
}
