{
  "realm": "kse-pm",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "external",
  "browserFlow": "browser-passwordless",
  "loginTheme": "kse-pm",
  "webAuthnPolicyPasswordlessRpEntityName": "passwd.team",
  "webAuthnPolicyPasswordlessRpId": "",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "platform",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "requiredActions": [
    { "alias": "webauthn-register-passwordless", "name": "Webauthn Register Passwordless", "providerId": "webauthn-register-passwordless", "enabled": true, "defaultAction": false, "priority": 10 }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-passwordless",
      "description": "No email/password form. Passkey execution renders the choice page (passkey + Google); see docs/KEYCLOAK.md.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false, "autheticatorFlow": false },
        { "authenticator": "identity-provider-redirector", "requirement": "ALTERNATIVE", "priority": 25, "userSetupAllowed": false, "autheticatorFlow": false },
        { "authenticator": "webauthn-authenticator-passwordless", "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false, "autheticatorFlow": false }
      ]
    },
    {
      "alias": "browser-google-reauth",
      "description": "account-console only: SSO cookie, otherwise straight to Google, so 'Set up passkey' can re-authenticate a user who has no passkey. Never bind realm-wide. See docs/KEYCLOAK.md.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false, "autheticatorFlow": false },
        { "authenticator": "identity-provider-redirector", "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false, "autheticatorFlow": false,
          "authenticatorConfig": "google-reauth-default" }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "google-reauth-default", "config": { "defaultProvider": "google" } }
  ],
  "clients": [
    {
      "clientId": "kse-pm-web",
      "name": "KSE Password Manager Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      }
    },
    {
      "clientId": "kse-pm-extension",
      "name": "KSE Password Manager Extension",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/extension-callback"],
      "webOrigins": ["chrome-extension://aafmkmcilcgfipkinadcibpgehoiifegh"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [{
        "name": "extension-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": { "included.client.audience": "kse-pm-extension", "id.token.claim": "false", "access.token.claim": "true" }
      }]
    },
    {
      "clientId": "kse-pm-federation",
      "name": "KSE Password Manager Google Workspace federation",
      "description": "Machine-to-machine client_credentials grant only. The backend exchanges this token at Google STS (workload identity federation) so Directory/Drive delegation never needs a downloaded service-account key or a gcloud user credential. See docs/DEPLOYMENT.md.",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${WORKSPACE_FEDERATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [{
        "name": "google-sts-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.custom.audience": "${WORKSPACE_FEDERATION_AUDIENCE}",
          "id.token.claim": "false",
          "access.token.claim": "true"
        }
      }]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "1079689084620-atn9rami8ug35fqdqp197bngglrckjb7.apps.googleusercontent.com",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "hostedDomain": "kse-ai-analyzer.biz.ua",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    }
  ]
}
