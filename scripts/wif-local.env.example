# Local development: Keycloak on http://localhost:8081.
#
# Google cannot reach localhost, so the provider is created with the realm's
# JWKS uploaded inline (ISSUER_MODE=jwks) — Google never calls Keycloak, it
# only checks that the token's `iss` claim equals the issuer below and that the
# signature verifies against the uploaded keys. Re-run the script if the realm's
# signing keys ever rotate.
#
#   cp scripts/wif-local.env.example scripts/wif-local.env   # gitignored
#   $EDITOR scripts/wif-local.env
#   set -a && . scripts/wif-local.env && set +a && ./scripts/setup-workload-identity.sh
#
# Note: this proves the wiring end to end on a laptop, but it pins Google to a
# pool whose issuer is a localhost URL. Use a separate pool name from
# production (POOL below) so the two never collide.

GCP_PROJECT=kse-pm
TARGET_SA=directory-sync@kse-pm-dev.iam.gserviceaccount.com

KEYCLOAK_URL=http://localhost:8081
REALM=kse-pm
ISSUER_MODE=jwks

POOL=kse-pm-local
PROVIDER=keycloak

# Must equal the secret Keycloak imported into the kse-pm-federation client,
# i.e. the same value that was in the Keycloak container's environment.
WORKSPACE_FEDERATION_CLIENT_SECRET=
