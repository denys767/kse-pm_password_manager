# Production: Keycloak on a public HTTPS host.
#
# Google discovers the realm's keys itself via
# https://auth.pm.example.com/realms/kse-pm/.well-known/openid-configuration,
# so signing-key rotation needs no action here — this is why discovery mode is
# the right choice whenever the issuer is publicly reachable.
#
#   cp scripts/wif-prod.env.example scripts/wif-prod.env   # gitignored
#   $EDITOR scripts/wif-prod.env
#   set -a && . scripts/wif-prod.env && set +a && ./scripts/setup-workload-identity.sh
#
# The certificate must be publicly trusted; a self-signed staging cert will
# make Google's discovery fetch fail. If Keycloak is deliberately internal-only,
# set ISSUER_MODE=jwks instead and re-run on every realm key rotation.

GCP_PROJECT=kse-pm
TARGET_SA=directory-sync@kse-pm-prod.iam.gserviceaccount.com

KEYCLOAK_URL=https://auth.pm.example.com
REALM=kse-pm
ISSUER_MODE=discovery

POOL=kse-pm
PROVIDER=keycloak

# Read this from your secret manager rather than committing it.
WORKSPACE_FEDERATION_CLIENT_SECRET=
