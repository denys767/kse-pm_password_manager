{
  "manifest_version": 3,
  "name": "KSE Password Manager",
  "version": "0.1.0",
  "description": "KSE Password Manager autofill MVP",
  "action": { "default_popup": "popup.html", "default_title": "KSE Password Manager" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["identity", "storage", "activeTab", "scripting", "clipboardWrite", "alarms", "offscreen"],
  "host_permissions": ["http://localhost:8080/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
